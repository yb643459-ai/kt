/* ============================================================
   קול תורה — לוח שמחות
   פלטה: ink (כחל לילה), parchment (קלף), wine (חותם שעווה),
          gold (הפרדות עדינות), teal (הדגשה משנית)
   טיפוגרפיה: Frank Ruhl Libre לכותרות, Assistant לגוף הטקסט
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700;900&family=Assistant:wght@400;500;600;700;800&display=swap');

:root {
  --ink: #14213a;
  --ink-2: #1d2f4f;
  --parchment: #fbf3e3;
  --parchment-2: #f3e8d0;
  --wine: #7a2331;
  --wine-dark: #591a24;
  --gold: #c9a227;
  --teal: #2f5d62;
  --ink-text: #241a10;
  --muted: #6b6355;
  --radius: 14px;
  --shadow: 0 10px 30px rgba(20, 33, 58, 0.18);
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--ink);
  color: var(--ink-text);
  font-family: 'Assistant', sans-serif;
  direction: rtl;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(1200px 600px at 50% -10%, var(--ink-2), transparent),
    var(--ink);
}

h1, h2, h3, .display {
  font-family: 'Frank Ruhl Libre', serif;
  font-weight: 700;
  margin: 0;
}

a { color: inherit; }

:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 2px;
}

/* ---------- מבנה כללי ---------- */
.site-header {
  text-align: center;
  padding: 38px 20px 26px;
  color: var(--parchment);
}

.site-header .eyebrow {
  font-size: 13px;
  letter-spacing: 0.14em;
  color: var(--gold);
  text-transform: none;
  margin-bottom: 8px;
}

.site-header h1 {
  font-size: clamp(32px, 6vw, 52px);
  color: var(--parchment);
}

.site-header p {
  color: #cdd8e6;
  margin-top: 8px;
  font-size: 16px;
}

.nav-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--gold);
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 14px;
}

.page {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 18px 60px;
}

.card-panel {
  background: var(--parchment);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 26px;
  position: relative;
}

/* ---------- דף הבית ---------- */
.gates {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
  max-width: 880px;
  margin: 10px auto 0;
  padding: 0 18px;
}

@media (max-width: 640px) {
  .gates { grid-template-columns: 1fr; }
}

.gate {
  background: var(--parchment);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 34px 24px;
  text-decoration: none;
  color: var(--ink-text);
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  border-top: 6px solid var(--wine);
}

.gate:nth-child(2) { border-top-color: var(--teal); }

.gate:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(20,33,58,0.28); }

.gate .gate-icon { font-size: 40px; display: block; margin-bottom: 14px; }
.gate h2 { font-size: 26px; margin-bottom: 8px; }
.gate p { color: var(--muted); font-size: 15px; margin: 0; }

/* ---------- חותם האישור — האלמנט החתום של העיצוב ---------- */
.seal {
  position: absolute;
  top: -10px;
  left: -10px;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--wine), var(--wine-dark));
  border: 3px solid var(--gold);
  color: var(--parchment);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Frank Ruhl Libre', serif;
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  line-height: 1.15;
  transform: rotate(-14deg);
  box-shadow: 0 4px 10px rgba(0,0,0,0.25);
}

/* ---------- כפתורים ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: none;
  border-radius: 999px;
  padding: 11px 22px;
  font-family: 'Assistant', sans-serif;
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
  text-decoration: none;
  transition: filter 0.15s ease, transform 0.1s ease;
}
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--wine); color: var(--parchment); }
.btn-primary:hover { filter: brightness(1.1); }
.btn-secondary { background: var(--teal); color: var(--parchment); }
.btn-secondary:hover { filter: brightness(1.1); }
.btn-ghost { background: transparent; color: var(--wine); border: 2px solid var(--wine); }
.btn-danger { background: transparent; color: #a33; border: 2px solid #a33; }
.btn-sm { padding: 7px 14px; font-size: 13px; }

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 18px;
}

.tabs { display: flex; gap: 8px; background: rgba(20,33,58,0.06); padding: 5px; border-radius: 999px; }
.tab-btn {
  border: none; background: transparent; padding: 8px 18px; border-radius: 999px;
  font-weight: 700; cursor: pointer; color: var(--muted); font-family: 'Assistant', sans-serif; font-size: 14px;
}
.tab-btn.active { background: var(--ink); color: var(--parchment); }

/* ---------- טבלה ---------- */
.table-wrap { overflow-x: auto; }
table.data-table { width: 100%; border-collapse: collapse; font-size: 15px; }
.data-table th, .data-table td {
  padding: 12px 10px;
  text-align: right;
  border-bottom: 1px solid var(--parchment-2);
}
.data-table th { color: var(--muted); font-weight: 700; font-size: 13px; }
.data-table tr:hover td { background: rgba(122,35,49,0.04); }

.avatar {
  width: 46px; height: 46px; border-radius: 50%; object-fit: cover;
  border: 2px solid var(--gold); cursor: zoom-in; background: var(--parchment-2);
}
.avatar-placeholder {
  width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--parchment-2); color: var(--muted); font-size: 18px; border: 2px solid var(--parchment-2);
}

.empty-state {
  text-align: center; padding: 50px 20px; color: var(--muted);
}
.empty-state .big { font-size: 34px; display: block; margin-bottom: 8px; }

/* ---------- לוח שנה ---------- */
.calendar-head {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;
}
.calendar-head h3 { font-size: 20px; }
.calendar-nav { display: flex; gap: 8px; }
.icon-btn {
  border: 2px solid var(--wine); background: transparent; color: var(--wine);
  border-radius: 50%; width: 34px; height: 34px; cursor: pointer; font-size: 16px; font-weight: 700;
}
.icon-btn:hover { background: var(--wine); color: var(--parchment); }

.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-dow { text-align: center; font-size: 12px; color: var(--muted); font-weight: 700; padding-bottom: 4px; }
.cal-cell {
  min-height: 74px; border-radius: 8px; background: rgba(20,33,58,0.03);
  padding: 4px; font-size: 11px; position: relative;
}
.cal-cell.empty { background: transparent; }
.cal-cell.today { outline: 2px solid var(--gold); background: rgba(201,162,39,0.12); }
.cal-cell .day-num { font-weight: 800; font-size: 13px; color: var(--ink); }
.cal-cell .event-chip {
  display: block; background: var(--wine); color: var(--parchment); border-radius: 5px;
  padding: 2px 4px; margin-top: 2px; font-size: 10.5px; line-height: 1.3; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}

/* ---------- מודלים ---------- */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(20,33,58,0.55);
  display: none; align-items: center; justify-content: center; padding: 16px; z-index: 60;
}
.modal-overlay.open { display: flex; }
.modal-box {
  background: var(--parchment); border-radius: var(--radius); max-width: 520px; width: 100%;
  max-height: 88vh; overflow-y: auto; padding: 26px; box-shadow: var(--shadow); position: relative;
}
.modal-close {
  position: absolute; top: 14px; left: 14px; background: none; border: none; font-size: 22px;
  cursor: pointer; color: var(--muted);
}
.modal-box h2 { font-size: 22px; margin-bottom: 6px; }
.modal-box .sub { color: var(--muted); font-size: 14px; margin-bottom: 18px; }

.field { margin-bottom: 14px; }
.field label { display: block; font-weight: 700; font-size: 14px; margin-bottom: 5px; }
.field input, .field select {
  width: 100%; padding: 10px 12px; border-radius: 8px; border: 1.5px solid var(--parchment-2);
  font-family: 'Assistant', sans-serif; font-size: 15px; background: #fff;
}
.field input:focus, .field select:focus { border-color: var(--teal); }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 520px) { .field-row { grid-template-columns: 1fr; } }
.field-hint { font-size: 12px; color: var(--muted); margin-top: 4px; }

.section-divider { border: none; border-top: 2px dotted var(--gold); margin: 18px 0; }

.form-msg { padding: 10px 14px; border-radius: 8px; font-size: 14px; margin-bottom: 14px; }
.form-msg.success { background: #e4f0e2; color: #2c5c2a; }
.form-msg.error { background: #f6e2e2; color: #8a2a2a; }

.loading-row { text-align: center; padding: 30px; color: var(--muted); }

footer.site-footer {
  text-align: center; color: #9fb0c4; font-size: 13px; padding: 30px 16px 40px;
}
footer.site-footer a { color: var(--gold); text-decoration: none; }
